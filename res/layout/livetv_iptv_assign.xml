<?xml version="1.0" encoding="utf-8"?>
<!-- "Assign channels" (LiveTV IPTV): which guide channel gives its programs to each channel. Also
     the guide channel picker, with its search field shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/livetv_icon_background"
    android:orientation="vertical"
    android:paddingStart="96dp"
    android:paddingTop="48dp"
    android:paddingEnd="96dp">

    <TextView
        android:id="@+id/livetv_assign_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/livetv_assign_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/livetv_assign_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/livetv_assign_search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        android:visibility="gone" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/livetv_assign_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="48dp" />
</LinearLayout>
