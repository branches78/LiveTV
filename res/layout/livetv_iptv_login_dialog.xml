<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog of the LiveTV IPTV setup screen for a list with a username and a password. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/livetv_iptv_login_description"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/livetv_iptv_login_server"
        android:text="@string/livetv_iptv_login_server"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <EditText
        android:id="@+id/livetv_iptv_login_server"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/livetv_iptv_login_server_hint"
        android:imeOptions="actionNext"
        android:inputType="textUri"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:labelFor="@+id/livetv_iptv_login_username"
        android:text="@string/livetv_iptv_login_username"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <EditText
        android:id="@+id/livetv_iptv_login_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:labelFor="@+id/livetv_iptv_login_password"
        android:text="@string/livetv_iptv_login_password"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <EditText
        android:id="@+id/livetv_iptv_login_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:singleLine="true" />

    <CheckBox
        android:id="@+id/livetv_iptv_login_show_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/livetv_iptv_login_show_password" />
</LinearLayout>
