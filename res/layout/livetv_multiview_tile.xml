<!-- One tile of the multiview: the video of a channel, or a "+" to add one. The frame is the
     foreground, so that it is drawn over the video. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A1A"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/livetv_multiview_tile_frame">

    <SurfaceView
        android:id="@+id/livetv_multiview_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/livetv_multiview_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.8"
            android:src="@drawable/ic_livetv_multiview_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@string/condensed_font"
            android:text="@string/livetv_multiview_add"
            android:textColor="#CCEEEEEE"
            android:textSize="18sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/livetv_multiview_buffering"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/livetv_multiview_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:text="@string/livetv_multiview_error"
        android:textColor="#CCEEEEEE"
        android:textSize="16sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/livetv_multiview_sound"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/livetv_multiview_badge"
        android:padding="5dp"
        android:src="@drawable/ic_livetv_multiview_sound"
        android:visibility="gone" />

    <TextView
        android:id="@+id/livetv_multiview_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/livetv_multiview_label_background"
        android:ellipsize="end"
        android:fontFamily="@string/condensed_font"
        android:paddingBottom="8dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:singleLine="true"
        android:textColor="#FFEEEEEE"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
