<!-- Movies or series: the categories in a side panel like the one of the program guide, the
     titles in a grid. As in the guide, the side panel shows only its edge until LEFT opens it;
     RIGHT closes it again. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lb="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0B">

    <FrameLayout
        android:id="@+id/livetv_vod_side_panel"
        android:layout_width="@dimen/program_guide_side_panel_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/program_guide_side_panel_margin_start"
        android:background="@color/program_guide_side_panel_background"
        android:clipToPadding="false"
        android:elevation="@dimen/program_guide_side_panel_elevation"
        android:paddingStart="@dimen/program_guide_side_panel_padding_start"
        android:paddingEnd="@dimen/program_guide_side_panel_padding_end">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/livetv_vod_categories"
            android:layout_width="@dimen/program_guide_side_panel_item_width"
            android:layout_height="match_parent"
            android:layout_gravity="top|start"
            android:alpha="0.0"
            android:focusable="true"
            android:focusableInTouchMode="true"
            lb:focusOutFront="true" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/livetv_vod_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/livetv_vod_grid_margin_start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <TextView
            android:id="@+id/livetv_vod_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/livetv_vod_grid_margin_end"
            android:paddingStart="@dimen/livetv_vod_grid_padding_start"
            android:ellipsize="end"
            android:fontFamily="@string/condensed_font"
            android:singleLine="true"
            android:textColor="#FFEEEEEE"
            android:textSize="28sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/livetv_vod_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:paddingEnd="@dimen/livetv_vod_grid_margin_end"
                android:paddingStart="@dimen/livetv_vod_grid_padding_start"
                android:paddingTop="20dp" />

            <ProgressBar
                android:id="@+id/livetv_vod_progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/livetv_vod_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingEnd="@dimen/livetv_vod_grid_margin_end"
                android:textColor="#B3EEEEEE"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
